.env
.venv/
bot.lock
__pycache__/
.pytest_cache/
*.pyc
output*/
*.log
.crawl4ai/
# Modelos locais pesados (BERTimbau 400MB+): nunca commitar; ligar via FAKE_MODEL_PATH
bertimbau-*/
*.safetensors
*.bin
# Zip do BERTimbau v6 (~400 MB, acima do limite do GitHub) e sua extração: vão ao Cloud Run pelo --source, não ao git
modelo/
# Telemetria (traces por execução) e resultados de eval (versionar só eval/baseline.json)
runs/
eval/resultados/*/
eval/serpapi_uso.json.lock
# Cassetes de replay (HTTP+LLM gravados): centenas de MB e HTML de terceiros — regravar com `eval.run --modo record`
eval/cassettes/
# Contador local de uso da SerpAPI (estado de máquina)
eval/serpapi_uso.json
# Resultados da avaliação golden do PR2 (gerados localmente)
avaliacao/resultados/
reports/
.env.producao
.env33
